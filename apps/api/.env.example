# =========================================================
# Variables de entorno - Backend Hasbun API
# Copiar a .env y completar. NUNCA commitear el .env real.
# =========================================================

# --- Entorno ---
ENVIRONMENT=development                 # development | staging | production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://hasbun:hasbun@localhost:5432/hasbun
DATABASE_URL_TEST=postgresql+asyncpg://hasbun:hasbun@localhost:5432/hasbun_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Seguridad / JWT ---
SECRET_KEY=change-me-por-favor-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Almacenamiento S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=hasbun
S3_REGION=us-east-1

# --- WhatsApp ---
WHATSAPP_PROVIDER=mock                 # mock | twilio | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_MOCK_FAIL_RATE=0.0

# --- Tipo de cambio ---
EXCHANGE_RATE_PROVIDER=mock            # mock | sunat | bcp
MOCK_EXCHANGE_RATE_USD_PEN=3.75
EXCHANGE_RATE_UPDATE_HOUR=9            # hora local para tarea diaria Celery

# --- Archivos (FileObject / MinIO) ---
FILE_MAX_SIZE_BYTES=10485760           # 10MB
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
FILE_SIGNED_URL_TTL_SECONDS=3600

# --- Generador de SKU (mapa categoría→prefijo, JSON) ---
SKU_PREFIX_BY_CATEGORY_SLUG={"laptops":"LAP","computadoras":"CPT","impresoras":"IMP","camaras":"CAM","accesorios":"ACC","electrodomesticos":"ELE","monitores":"MON","celulares":"CEL","tablets":"TAB","redes":"RED","almacenamiento":"ALM"}
SKU_DEFAULT_PREFIX=PRD

# --- Cifrado de credenciales de equipos ---
CREDENTIAL_ENCRYPTION_KEY=

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2